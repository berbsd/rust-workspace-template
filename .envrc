# =============================================================================
# direnv Configuration
# =============================================================================
# Automatically configures your shell environment when entering this directory.
#
# Setup (one-time):
#   1. Install direnv: brew install direnv (macOS) or apt install direnv (Linux)
#   2. Add hook to shell (add to ~/.bashrc, ~/.zshrc, etc.):
#      eval "$(direnv hook bash)"   # for bash
#      eval "$(direnv hook zsh)"    # for zsh
#   3. Allow this directory: direnv allow
#
# What this does:
#   - Adds ./bin to PATH (for project scripts)
#   - Adds ./.cargo/bin to PATH (project-local tool installs — ast-grep,
#     cargo-dylint, dylint-link — kept out of ~/.cargo/bin deliberately; see
#     bin/bootstrap's header comment)
#   - Loads .env file if present (environment variables)
#
# To add more environment setup:
#   - Add export statements below
#   - Run `direnv allow` after changes
#
# Documentation: https://direnv.net/
# =============================================================================

# Add project bin directory to PATH
# This allows running ./bin/bootstrap as just `bootstrap`
PATH_add bin

# Project-local tool installs (bin/bootstrap installs ast-grep/cargo-dylint/
# dylint-link here with `cargo install --root ./.cargo`, instead of the
# global ~/.cargo/bin, so this repo's tool versions stay scoped to this
# checkout). PATH_add is a no-op if the directory doesn't exist yet.
PATH_add .cargo/bin

# Load .env file if it exists (for local development secrets)
# Note: .env is gitignored and should never be committed
dotenv_if_exists

# =============================================================================
# Optional: Uncomment and customize as needed
# =============================================================================

# --- Rust Configuration ---
# export RUST_BACKTRACE=1              # Enable backtraces on panic
# export RUST_LOG=info                 # Default log level

# sccache: compiler cache surviving `cargo clean` and branch switches.
# Requires `brew install sccache`. sccache is incompatible with cargo
# incremental, so CARGO_INCREMENTAL=0 is set explicitly to silence the warning
# — that is a real cost, paid for the caching below.
#
# NOT shared across worktrees. SCCACHE_DIR below puts the cache inside the
# checkout, so each worktree keeps its own; the header used to claim sharing
# that the SCCACHE_DIR comment then denied a few lines later.
if has sccache; then
  export RUSTC_WRAPPER=sccache
  export CARGO_INCREMENTAL=0
  # 40G, not the 10 GiB default. sccache evicts LRU at the cap and needs no
  # pruning, so the only question is whether the working set fits — and it did
  # not: the cache sat exactly at 10G with a 0.20% hit rate, which is what a
  # cache thrashing rather than serving looks like.
  #
  # Two things make this workspace expensive to cache. Roughly 60% of compile
  # calls are refused outright (`sccache --show-stats` reports `crate-type` as
  # the dominant non-cacheable reason), so the cap only ever governs the
  # remainder; and dev artifacts carried full DWARF until `[profile.dev]` in
  # the root manifest cut them back. Re-read `--show-stats` before tuning this
  # again — if the Rust hit rate stays near zero, the honest move is to drop
  # sccache locally and take CARGO_INCREMENTAL back, since Docker is where it
  # demonstrably pays (see docker/Dockerfile).
  export SCCACHE_CACHE_SIZE="40G"
  # Normalize the current repo/worktree root out of cache keys so any
  # checkout (main or worktree, anywhere on disk) produces identical keys
  # for identical sources and shares hits via the cache directory below.
  export SCCACHE_BASEDIR="$PWD"
  # Cache lives inside the current worktree so it travels with the
  # checkout. Trade-off: each worktree has its own cache — no sharing
  # between main and worktrees.
  export SCCACHE_DIR="$PWD/.sccache"
fi

# --- Database ---
